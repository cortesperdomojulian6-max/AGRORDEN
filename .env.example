# ============================================================================
# AGRORDEN · ERP Ganadero — Plantilla de variables de entorno
# Copiar a `.env` (nunca se sube al repo) y completar con valores reales.
# ============================================================================

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=agrorden
PGUSER=agrorden_app
PGPASSWORD=CAMBIAR_ESTA_CLAVE

# --- ETL (rutas locales de Excel; fuera del repo) ---
ETL_RAW_DIR=C:/ruta/local/excel_originales
